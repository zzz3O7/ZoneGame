# Google OAuth app credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must exactly match an "Authorized redirect URI" registered on the OAuth
# client above. Use your real domain in production.
GOOGLE_REDIRECT_URI=https://zonegame.randover.site/auth/google/callback

# Any long random string, e.g. `openssl rand -hex 32`. Used to sign
# session cookies so a tampered cookie is rejected without a lookup.
COOKIE_SECRET=

# Where to send the browser after a successful login (your frontend root)
FRONTEND_URL=https://zonegame.randover.site/

# Shared secret for the admin tool (server/admin*.js). Any long random
# string, e.g. `openssl rand -hex 32`. Leave unset to disable the admin
# API entirely — /admin/* returns 503 until this is set.
ADMIN_TOKEN=
